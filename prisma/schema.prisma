generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

enum SubscribeType {
  FREE
  LITE
  PRO
  BUSINESS
  NOT_SUBSCRIBED
}

enum SubscribePlan {
  MONTHLY
  THREE_MONTHS
  SIX_MONTHS
  YEARLY
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum UserLanguage {
  RU
  EN
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
}

enum PaymentProvider {
  CRYPTO_PAY
  ANTILOPAY
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(uuid())
  password  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model User {
  id        String   @id @default(uuid())

  telegramId String   @unique
  telegramUsername String?
  lastActivityAt DateTime?

  subscribeType SubscribeType @default(NOT_SUBSCRIBED)
  lastSubscriptionType SubscribeType?
  subscribePlan SubscribePlan?
  subscriptionStartsAt DateTime?
  subscriptionEndsAt DateTime?
  lastTokenIssueAt DateTime? 
  useFreeSub Boolean @default(false)
  isSubscriptionActive Boolean @default(false)

  tokenLeft Int @default(0)
  email String?
  language UserLanguage @default(RU)
  hasCompletedOnboarding Boolean @default(false)
  /// Auto-redirect to a similar-priced model on provider failure (image/video).
  autoModelFailover Boolean @default(true)

  nextSubscription NextSubscriptionOfUser?
  aiGenerationJobs AiGenerationJob[]
  payments Payment[]
  gptConversations GptConversation[]
  aiToolSettings UserAiToolSettings[]
  savedPrompts SavedPrompt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model ElevenLabsVoicePreview {
  id         String   @id @default(uuid())
  voiceId    String
  localeTag  String
  filePath   String
  sampleText String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([voiceId, localeTag])
  @@map("elevenlabs_voice_previews")
}

model UserAiToolSettings {
  id       String @id @default(uuid())
  userId   String
  toolId   String
  settings Json
  user     User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, toolId])
  @@map("user_ai_tool_settings")
}

model Payment {
  id                 String          @id @default(uuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id])
  provider           PaymentProvider
  cryptoPayInvoiceId BigInt?         @unique
  antilopayPaymentId String?         @unique
  orderId            String          @unique
  subscribeType      SubscribeType
  subscribePlan      SubscribePlan
  amountUsd          String?
  amountRub          String?
  status             PaymentStatus   @default(PENDING)
  paidAt             DateTime?
  createdAt          DateTime        @default(now())

  @@map("payments")
}

model NextSubscriptionOfUser {
  id String @id @default(uuid())

  user User @relation(fields: [userId], references: [id])
  userId String @unique
  subType SubscribeType
  subPlan SubscribePlan
  subscriptionEndsAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("next_subscription_of_users")
}

model AiGenerationJob {
  id            String    @id @default(uuid())
  userId        String
  toolId        String
  providerJobId String?
  status        JobStatus @default(PENDING)
  tokenCost     Int
  inputJson     Json
  resultUrl     String?
  /// Multi-output payload (MJ grid / Suno tracks) for mini-app + follow-up actions.
  resultJson    Json?
  errorMessage  String?
  pollAttempts  Int       @default(0)
  pollErrorCount Int      @default(0)
  lastPolledAt  DateTime?
  staleReminderSent Boolean @default(false)
  /// When false (mini-app), skip Telegram delivery of result / completion text.
  notifyTelegram Boolean  @default(true)
  /// Client-side chat session id (mini-app); groups generations into separate chats.
  sessionId     String?
  /// User-facing notice when the job was redirected to another model.
  failoverNotice String?
  /// Original tool before auto-failover chain started.
  failoverFromToolId String?
  /// Tool ids already tried in the failover chain (including the original).
  failoverTriedToolIds Json?
  /// Denormalized prompt for history list — avoids reading huge inputJson.
  prompt        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId, toolId, createdAt])
  @@index([userId, sessionId, createdAt])
  @@map("ai_generation_jobs")
}

model GptConversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  toolId    String   @default("gpt")
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  GptMessage[]

  @@index([userId, toolId, updatedAt])
  @@index([userId, updatedAt])
  @@map("gpt_conversations")
}

model GptMessage {
  id             String          @id @default(uuid())
  conversationId String
  conversation   GptConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String          @db.Text
  createdAt      DateTime        @default(now())

  @@index([conversationId, createdAt])
  @@map("gpt_messages")
}

model SavedPrompt {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId    String?
  prompt    String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("saved_prompts")
}