#Database
DATABASE_URL=

#Server
PORT=3001
# Public HTTPS base URL of this API (no trailing slash). Used for Antilopay callback/success/fail.
PUBLIC_BASE_URL=

#Telegram
TELEGRAM_BOT_TOKEN=

# Mini-app public URL(s) for CORS (required on Railway in production)
# Local: http://localhost:3000
# Railway: https://your-mini-app.up.railway.app
# Multiple origins: https://app1.up.railway.app,https://app2.up.railway.app
MINI_APP_ORIGIN=

# Public HTTPS URL of the mini-app (Menu Button + web_app keyboard)
# Local tunnel / Railway: https://your-mini-app.up.railway.app
MINI_APP_URL=

# Optional JWT secret for mini-app sessions (falls back to TELEGRAM_BOT_TOKEN)
JWT_SECRET=

#Crypto Pay (@send — https://t.me/send → /pay)
CRYPTOBOT_KEY=

#Apay site verification (meta tag on GET /)
APAY_VERIFICATION_TAG=

#Antilopay (RUB: card / SBP)
ANTILOPAY_SECRET_ID=
ANTILOPAY_PRIVATE_KEY=
ANTILOPAY_PROJECT_ID=
ANTILOPAY_CALLBACK_PUBLIC_KEY=
# Prod (default): https://lk.antilopay.com/api/v1
# Test credentials from Antilopay: https://stage.antilopay.com/api/v1
# ANTILOPAY_API_URL=https://stage.antilopay.com/api/v1
# Optional VAT rate if merchant is ОСНО: 10 or 22
# ANTILOPAY_VAT=
# Prefer methods (default: SBP). Comma-separated. Use "-" to omit the field.
# ANTILOPAY_PREFER_METHODS=SBP

#Redis
REDIS_URL=redis://:password@127.0.0.1:6379

#AI Providers
OPENAI_API_KEY=
# OpenAI: GPT, GPT Images, Sora video (4/8/12 sec)
OPENROUTER_API_KEY=
SHARPII_API_KEY=
SHARPII_API_URL=https://api.sharpii.ai
# Sharpii covers Midjourney/Seedance/Suno/Luma
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_DUBBING_TARGET_LANG=ru
# Sound effects (Генерация звуков)
ELEVENLABS_SFX_MODEL_ID=eleven_text_to_sound_v2
ELEVENLABS_SFX_PROMPT_INFLUENCE=0.75
ELEVENLABS_SFX_DURATION_SECONDS=5
# Cached voice preview files (Railway volume: /app/storage/voice-previews)
VOICE_PREVIEWS_DIR=/app/storage/voice-previews
# Optional override (default: https://api.elevenlabs.io/v1)
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
HEYGEN_API_KEY=
# Optional: look id from GET /v3/avatars/looks (if auto-pick fails)
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HIGGSFIELD_API_KEY=
# Platform DoP (effects/motions). Prefer KEY_ID:KEY_SECRET or separate secret:
# HIGGSFIELD_CREDENTIALS=key_id:key_secret
# HIGGSFIELD_API_SECRET=
TOPAZ_API_KEY=
LUMA_API_KEY=
BFL_API_KEY=
